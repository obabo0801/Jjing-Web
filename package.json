{
  "name": "jjing-web",
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#common/*": "./src/js/common/*.js",
    "#config/*": "./config/*.js",
    "#middleware/*": "./middleware/*.js",
    "#router/*": "./router/*.js",
    "#src/*": "./src/js/*.js",
    "#ui/*": "./src/js/ui/*.js",
    "#block": "./middleware/block.js",
    "#maint": "./middleware/maint.js",
    "#page": "./middleware/page.js",
    "#assets": "./middleware/static.js",
    "#upload": "./middleware/upload.js",
    "#error": "./middleware/error.js",
    "#router": "./router/index.js",
    "#audio/*": "./src/assets/audio/*"
  },
  "scripts": {
    "format": "eslint . --fix && prettier --write \"**/*.{js,css,html}\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js"
  },
  "dependencies": {
    "@google-cloud/speech": "^8.0.1",
    "@google-cloud/text-to-speech": "^7.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "sqlite3": "^6.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.1"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "sqlite3@6.0.1": true
  }
}
